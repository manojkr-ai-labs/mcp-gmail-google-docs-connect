# Google OAuth 2.0 client (Desktop or Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an authorized redirect URI in the Google Cloud Console
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/oauth2callback

# Local token store (gitignored). Created by `npm run auth`.
GOOGLE_TOKEN_PATH=.tokens/google-token.json

# Hosted (Railway): paste refresh_token from the local token file.
# GOOGLE_REFRESH_TOKEN=

# Required for Streamable HTTP (`PORT` set or MCP_TRANSPORT=http).
# openssl rand -hex 32
# MCP_AUTH_TOKEN=

# debug | info | warn | error
LOG_LEVEL=info
