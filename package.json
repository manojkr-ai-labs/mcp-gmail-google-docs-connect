{
  "name": "gmail-docs-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Generic MCP server for Gmail drafts/sends and Google Docs append",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/auth/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "googleapis": "178.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
